# The CSP style-src hash is written by scripts/build-css.js at build time; the
# source copy of this file holds a placeholder, the built copy in dist/ the real hash.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'sha256-BkVeJybth4NKdt7JvJkNBJeYsrR6Eqyq7q0+migaWow='; img-src 'self' data:; font-src 'self'; media-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types default
  ! Access-Control-Allow-Origin

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep stable names (no content hash), so they can't be immutable: fresh
# for a week, then served from cache while revalidating in the background for up
# to 30 days more. An image replaced under the same name reaches everyone within
# a week; rename it if it must change everywhere at once.
/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Pages has no MIME type for .ico and serves it as "Content-Type: null", which
# Cloudflare then won't compress. The root copy (made by build-html.js) is for
# clients that ask for /favicon.ico without reading the page's <link> tags.
/assets/img/favicon.ico
  Content-Type: image/x-icon

/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Everything here is content-addressed (main.<hash>.min.js and its map, named by
# scripts/fingerprint-js.js). New bytes always mean a new URL, so these can never
# go stale. Never add a mutable, referenced file.
/assets/min/*
  Cache-Control: public, max-age=31536000, immutable
